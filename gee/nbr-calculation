// Load Landsat 7 collection for a post-fire image 2012
var postFireImage = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
                  .filterDate('2012-03-13', '2012-12-31')
                  .map(maskL457sr);

var postFireImage2012 = postFireImage.median().clip(ROI);


Map.addLayer(postFireImage2012 , RGB, 'postFireImage2012 ');

// Function to calculate dNBR
function calculateDNBR(preFireImage, postFireImage2012) {
  var preNBR = calculateNBR(preFireImage);
  var postNBR = calculateNBR(postFireImage2012);
  return preNBR.subtract(postNBR).rename('dNBR2012');
}

// Function to classify dNBR into burn severity classes
function classifyBurnSeverity(dNBR2012) {
  return dNBR2012.gt(0.66).multiply(5)  // High Severity
          .add(dNBR2012.gt(0.44).and(dNBR2012.lte(0.66)).multiply(4))  // Moderate-high Severity
          .add(dNBR2012.gt(0.27).and(dNBR2012.lte(0.44)).multiply(3))  // Moderate Severity
          .add(dNBR2012.gt(0.1).and(dNBR2012.lte(0.27)).multiply(2))   // Low Severity
          .add(dNBR2012.gt(-0.1).and(dNBR2012.lte(0.1)).multiply(1))   // Unburned
          .rename('BurnSeverity2012');
}

// Calculate dNBR
var dNBR2012 = calculateDNBR(preFireImage, postFireImage2012);

// Classify burn severity
var BurnSeverity2012 = classifyBurnSeverity(dNBR2012);

